# Telegram Credentials
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
ALERT_CHANNELS=

# Google Gemini API
GEMINI_API_KEY=
# Optional override. Current stable default is gemini-3.5-flash-lite.
GEMINI_MODEL=gemini-3.5-flash-lite

# Persistent local state (mount ./data when running in Docker)
TELEGRAM_CURSOR_FILE=./data/telegram-cursors.json
FIRST_ALERT_STATE_FILE=./data/processor-state.json
# How long a published alert remains the deduplication baseline (minutes; default 15; 0 disables it)
LAST_PUBLISHED_DEDUP_WINDOW_MINUTES=15
TELEGRAM_SESSION_FILE=./data/telegram_session
WHATSAPP_AUTH_PATH=./data/wwebjs_auth

# WhatsApp Target
WHATSAPP_GROUPS=
